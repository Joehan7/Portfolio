# Set the final HTTPS origin before deployment. Do not include a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Contact delivery is deliberately unavailable until all server credentials exist.
RESEND_API_KEY=
CONTACT_FROM=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Enable only when deployed on Vercel.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
